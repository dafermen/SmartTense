{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "mutate": [
    "src/practice.js"
  ],
  "testRunner": "command",
  "commandRunner": {
    "command": "node --test tests/practice.test.js tests/propertyInvariants.test.js"
  },
  "coverageAnalysis": "off",
  "concurrency": 2,
  "timeoutMS": 10000,
  "reporters": [
    "clear-text",
    "progress"
  ],
  "thresholds": {
    "high": 95,
    "low": 90,
    "break": 90
  }
}
